
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "System users including Students, Staff, and Administrators.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["USER", "STAFF", "ADMIN"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "LostItem": {
      "title": "LostItem",
      "type": "object",
      "description": "Items reported as missing by users.",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "locationLost": { "type": "string" },
        "dateLost": { "type": "string", "format": "date" },
        "reportedByUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "reportedByUserId", "status"]
    },
    "FoundItem": {
      "title": "FoundItem",
      "type": "object",
      "description": "Items registered by staff as found.",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "locationFound": { "type": "string" },
        "dateFound": { "type": "string", "format": "date" },
        "registeredByUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "CLAIMED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "registeredByUserId", "status"]
    },
    "Claim": {
      "title": "Claim",
      "type": "object",
      "description": "Verification requests linking users to found items.",
      "properties": {
        "id": { "type": "string" },
        "foundItemId": { "type": "string" },
        "claimingUserId": { "type": "string" },
        "proofDescription": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "claimDate": { "type": "string", "format": "date-time" }
      },
      "required": ["foundItemId", "claimingUserId", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profiles indexed by Auth UID."
    },
    "/lost_items/{itemId}": {
      "schema": "#/entities/LostItem",
      "description": "Global collection of lost item reports."
    },
    "/found_items/{itemId}": {
      "schema": "#/entities/FoundItem",
      "description": "Global collection of found items managed by staff."
    },
    "/claims/{claimId}": {
      "schema": "#/entities/Claim",
      "description": "Claims linking users and items."
    }
  }
}
